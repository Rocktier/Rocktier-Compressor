node_modules/
compress-engine/compress-engine-windows.exe
compress-engine/compress-engine-macos
compress-engine/compress-engine-linux
src-tauri/compress-engine-windows.exe
src-tauri/compress-engine-macos
src-tauri/compress-engine-linux

# Build output
dist/
src-tauri/target/
src-tauri/gen/schemas/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Rust
# Cargo.lock is committed on purpose: an untracked lock lets cargo silently
# resolve a newer `tauri` than the pinned npm @tauri-apps/* versions, which makes
# the Windows MSIX bundle step fail the version precheck. (Family rule.)


# Keep go.mod/go.sum
!compress-engine/go.mod
!compress-engine/go.sum

# Local env
.env
.env.local

